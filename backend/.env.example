# -----------------------------------------------------------------------------
# FENTRI BACKEND - ENV EXAMPLE
# -----------------------------------------------------------------------------

# DATABASE (Configuracion local oficial con backend/docker-compose.yml)
DATABASE_URL="postgresql://fentri_user:fentri_password@localhost:5433/fentri_mvp?schema=public"
DIRECT_URL="postgresql://fentri_user:fentri_password@localhost:5433/fentri_mvp?schema=public"

# AUTH
JWT_SECRET="your_very_secret_key_here"

# APP CONFIG
PORT=3001

# STORAGE (LOCAL / SUPABASE)
# Para desarrollo local se recomienda 'local'
STORAGE_TYPE="local" 
UPLOAD_DIR="./uploads"
BASE_URL="http://localhost:3001"

# FRONTEND URL (para CORS y para construir links en emails)
# En producción: URL real de Vercel u otro host
FRONTEND_URL="http://localhost:3000"

# Email / Resend
# RESEND_API_KEY: obtener en resend.com — dejar vacío para deshabilitar emails en dev
RESEND_API_KEY=
# EMAIL_FROM: dirección de envío verificada en Resend
# Ejemplo temporal: contact@coremetricsmedia.com (cambiar cuando exista dominio definitivo de Fentri)
# El dominio debe estar verificado en Resend antes de usarlo en producción
EMAIL_FROM=contact@coremetricsmedia.com
# EMAIL_FROM_NAME: nombre visible del remitente
EMAIL_FROM_NAME=Fentri

# GeoIP (notificaciones de nuevo inicio de sesión)
# Ruta local al archivo GeoLite2-City.mmdb (MaxMind). No se versiona en git.
# - Desarrollo local: descargar el .mmdb desde tu cuenta de MaxMind
#   (requiere una license key gratuita, ver https://www.maxmind.com/en/geolite2/signup)
#   y colocarlo en, por ejemplo, backend/data/GeoLite2-City.mmdb
# - Railway/producción: montar el archivo vía un volumen persistente y apuntar
#   GEOIP_DATABASE_PATH a esa ruta. No incluir la license key de MaxMind en el
#   repo ni en un script de build/deploy con acceso público.
# Si la variable no está definida o el archivo no existe, la geolocalización
# se omite (login sigue funcionando, el email no mostrará ubicación).
GEOIP_DATABASE_PATH=/app/data/GeoLite2-City.mmdb

# Auth proxy IP signing (Vercel -> Railway)
# Mismo valor que AUTH_PROXY_HMAC_SECRET en el frontend/Vercel. Verifica el
# header x-fentri-client-ip firmado por frontend/src/app/auth-proxy — es la
# unica fuente confiable de la IP real del usuario, ya que Railway queda
# detras de Vercel en produccion. Si falta, el login sigue funcionando y cae
# a los fallbacks habituales (x-real-ip / req.ip / socket), pero la
# geolocalizacion puede resolver la IP de salida de Vercel en vez de la del
# usuario. No usar un valor real en este archivo de ejemplo.
AUTH_PROXY_HMAC_SECRET=
